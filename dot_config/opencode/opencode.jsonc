  },
  "agent": {
    "build": {
      "options": {
        "store": false
      }
    },
    "plan": {
      "options": {
        "store": false
      }
    }
  },
  "shell": "/bin/zsh",
  "autoupdate": "notify",
  "share": "manual",
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 4
  },
  "$schema": "https://opencode.ai/config.json"
}
