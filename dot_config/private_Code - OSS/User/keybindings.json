// Place your key bindings in this file to override the defaults
[
       // 配合vim插件，按下ctrl+e可以在编辑区和资源管理器中来回切换，并且在资源管理器中按下a可以新建文件，r可以重命名，c可以复制，v可以粘贴，d可以删除
    {
        "key": "ctrl+e",
        "command": "workbench.files.action.focusFilesExplorer",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+e",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "!editorTextFocus"
    },
    {
        "key": "a",
        "command": "explorer.newFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "r",
        "command": "renameFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "c",
        "command": "filesExplorer.copy",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "v",
        "command": "filesExplorer.paste",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "d",
        "command": "deleteFile",
        "when": "filesExplorerFocus && !inputFocus"
    },

    // 在Visual模式下，按下ctrl+=可以扩展选区，按下ctrl+-可以缩小选区
    {
        "key": "ctrl+=",
        "command": "editor.action.smartSelect.expand",
        "when": "editorTextFocus && vim.mode == 'Visual'"
    },
    {
        "key": "ctrl+-",
        "command": "editor.action.smartSelect.shrink",
        "when": "editorTextFocus && vim.mode == 'Visual'"
    },

    // 按下alt+j可以将当前行向下移动，按下alt+k可以将当前行向上移动
    {
        "key": "alt+n",
        "command": "editor.action.moveLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "alt+p",
        "command": "editor.action.moveLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    // 按下ctrl+l可以切换到下一个编辑器，按下ctrl+h可以切换到上一个编辑器
    {
        "key": "ctrl+l",
        "command": "workbench.action.nextEditor",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+h",
        "command": "workbench.action.previousEditor",
        "when": "editorTextFocus && !editorReadonly"
    },
    // 在insert模式下模拟Emacs操作
    // 1. 基础移动 (Emacs Style)
    {
        "key": "ctrl+a",
        "command": "cursorHome",
        "when": "editorTextFocus && vim.mode == 'Insert'"
    },
    {
        "key": "ctrl+e",
        "command": "cursorEnd",
        "when": "editorTextFocus && vim.mode == 'Insert'"
    },
    {
        "key": "ctrl+f",
        "command": "cursorRight",
        "when": "editorTextFocus && vim.mode == 'Insert'"
    },
    {
        "key": "ctrl+b",
        "command": "cursorLeft",
        "when": "editorTextFocus && vim.mode == 'Insert'"
    },
    {
        "key": "ctrl+p",
        "command": "cursorUp",
        "when": "editorTextFocus && vim.mode == 'Insert'"
    },
    {
        "key": "ctrl+n",
        "command": "cursorDown",
        "when": "editorTextFocus && vim.mode == 'Insert'"
    },

    // 2. 删除与操作
    {
        "key": "ctrl+d",
        "command": "deleteRight",
        "when": "editorTextFocus && vim.mode == 'Insert'"
    },
    {
        "key": "ctrl+k",
        "command": "deleteAllRight",
        "when": "editorTextFocus && vim.mode == 'Insert'"
    },
    {
        "key": "ctrl+y",
        "command": "editor.action.clipboardPasteAction",
        "when": "editorTextFocus && vim.mode == 'Insert'"
    },

    // 3. 取消与退出 (C-g 模拟 Esc)
    {
        "key": "ctrl+g",
        "command": "extension.vim_escape",
        "when": "editorTextFocus && vim.mode == 'Insert'"
    },

    // 模拟 M-w (复制选区)
    {
        "key": "alt+w",
        "command": "editor.action.clipboardCopyAction",
        "when": "editorTextFocus && vim.mode == 'Insert'"
    },
    // 模拟 M-d (删除光标后的单词)
    {
        "key": "alt+d",
        "command": "deleteWordRight",
        "when": "editorTextFocus && vim.mode == 'Insert'"
    },
    // 模拟 M-Backspace (删除光标前的单词)
    {
        "key": "alt+backspace",
        "command": "deleteWordLeft",
        "when": "editorTextFocus && vim.mode == 'Insert'"
    }

]
