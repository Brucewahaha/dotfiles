#!/bin/sh

set -eu

mode=${1:-area}
directory=${XDG_PICTURES_DIR:-"$HOME/Pictures"}/Screenshots
mkdir -p "$directory"
file="$directory/$(date '+%Y-%m-%d_%H-%M-%S').png"

case "$mode" in
    area)
        geometry=$(slurp) || exit 0
        grim -g "$geometry" "$file"
        ;;
    output)
        output=$(swaymsg -t get_outputs -r | jq -r '.[] | select(.focused) | .name')
        grim -o "$output" "$file"
        ;;
    *)
        printf 'Usage: %s {area|output}\n' "$0" >&2
        exit 2
        ;;
esac

wl-copy --type image/png < "$file"
notify-send -a Screenshot 'Screenshot saved' "$file"
