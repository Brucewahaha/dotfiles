# 1. OMZ 核心设置
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="bira"

# 2. 定义 OMZ 插件列表 (只放 OMZ 自带的，或者已放入 $ZSH_CUSTOM 的)
# 注意：我们把 zsh-autosuggestions 从这里去掉，改用下面的手动加载方式
plugins=(git extract web-search)

# 3. 启动 Oh My Zsh
source $ZSH/oh-my-zsh.sh

# 4. 加载第三方插件 (在 OMZ 启动后加载，避免干扰)
export ZSH_CUSTOM_PLUGINS="$HOME/.config/zsh/plugins"

if [ -d "$ZSH_CUSTOM_PLUGINS" ]; then
    source $ZSH_CUSTOM_PLUGINS/zsh-autosuggestions/zsh-autosuggestions.zsh
    source $ZSH_CUSTOM_PLUGINS/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# 5. 加载个人别名
if [ -f "$HOME/.config/zsh/aliases.zsh" ]; then
    source "$HOME/.config/zsh/aliases.zsh"
fi

# 初始化 zoxide (更好的 cd 命令，会自动记录你常去的目录)
eval "$(zoxide init zsh)"
# 以后你可以用 'z path' 代替 'cd path'，甚至直接 'z 文件夹名部分字符'

# 初始化 fzf (模糊查找)
# 它会启用 Ctrl+T (找文件), Ctrl+R (找历史命令), Alt+C (切换目录)
[ -f /usr/share/fzf/key-bindings.zsh ] && source /usr/share/fzf/key-bindings.zsh
[ -f /usr/share/fzf/completion.zsh ] && source /usr/share/fzf/completion.zsh
