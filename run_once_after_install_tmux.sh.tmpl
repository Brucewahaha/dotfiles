#!/bin/sh

set -u

install_with_brew() {
    package="$1"
    if command -v brew >/dev/null 2>&1; then
        brew install "$package"
        return $?
    fi
    return 1
}

install_with_pacman() {
    package="$1"
    if command -v pacman >/dev/null 2>&1; then
        sudo pacman -S --noconfirm "$package"
        return $?
    fi
    return 1
}

install_with_apt() {
    package="$1"
    if command -v apt-get >/dev/null 2>&1; then
        sudo apt-get update && sudo apt-get install -y "$package"
        return $?
    fi
    return 1
}

ensure_dependency() {
    package="$1"
    binary="$2"
    apt_package="${3:-$1}"

    if command -v "$binary" >/dev/null 2>&1; then
        return 0
    fi

    install_with_brew "$package" || \
        install_with_pacman "$package" || \
        install_with_apt "$apt_package"
}

ensure_git_repo() {
    url="$1"
    dir="$2"

    if ! command -v git >/dev/null 2>&1; then
        printf 'failed to install plugin from %s: git not found\n' "$url" >&2
        return 1
    fi

    if [ -d "$dir/.git" ]; then
        if git -C "$dir" pull --ff-only; then
            return 0
        fi

        printf 'failed to update plugin repo %s\n' "$dir" >&2
        return 1
    fi

    if [ -d "$dir" ]; then
        backup="$dir.backup.$(date +%Y%m%d%H%M%S)"
        printf 'warning: %s exists but is not a git repo, moving it to %s\n' "$dir" "$backup" >&2
        if ! mv "$dir" "$backup"; then
            printf 'failed to move existing plugin dir %s\n' "$dir" >&2
            return 1
        fi
    fi

    if git clone "$url" "$dir"; then
        return 0
    fi

    printf 'failed to clone plugin repo %s\n' "$url" >&2
    return 1
}

install_tmux_plugins() {
    plugin_dir="$HOME/.tmux/plugins"
    tpm_dir="$plugin_dir/tpm"

    mkdir -p "$plugin_dir"
    ensure_git_repo https://github.com/tmux-plugins/tpm "$tpm_dir" || return 1

    if [ ! -f "$HOME/.tmux.conf" ]; then
        printf 'failed to locate tmux config at %s\n' "$HOME/.tmux.conf" >&2
        return 1
    fi

    if [ ! -x "$tpm_dir/bin/install_plugins" ]; then
        printf 'failed to locate TPM install script at %s\n' "$tpm_dir/bin/install_plugins" >&2
        return 1
    fi

    "$tpm_dir/bin/install_plugins"
}

main() {
    ensure_dependency git git git || {
        printf 'warning: failed to ensure git is installed\n' >&2
        return 1
    }

    ensure_dependency tmux tmux tmux || {
        printf 'warning: failed to ensure tmux is installed\n' >&2
        return 1
    }

    install_tmux_plugins
}

main "$@"
